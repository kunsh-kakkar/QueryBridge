# =============================================================================
# QueryBridge configuration  –  copy to `.env` and adjust:   cp .env.example .env
# Every QB_* value is optional; the defaults shown are used when a line is absent.
# NEVER commit your real .env (it is git-ignored).
# =============================================================================

# --- AI provider ----------------------------------------------------------------
# One API key is needed for live SQL generation. QueryBridge uses Google Gemini,
# which has a free tier: create a key in Google AI Studio
# (https://aistudio.google.com, sign in with a Google account). The free tier
# has daily request limits per model, and Google may use free-tier prompts
# (questions, table structure, example values) to improve its products.
GEMINI_API_KEY=

# Model used for SQL generation and correction. Blank = gemini-3.5-flash-lite.
QB_MODEL=
# Optional separate model for the semantic verification stage (blank = QB_MODEL).
# With Gemini, a different free model here spreads the work over two daily limits.
QB_VERIFIER_MODEL=

# Reasoning effort per pipeline stage: low | medium | high | xhigh | max
# (Gemini 3+: thinking level low / medium / high; xhigh and max become high
# except on models that support xhigh.)
QB_GENERATION_EFFORT=medium
QB_VERIFICATION_EFFORT=low
QB_CORRECTION_EFFORT=medium
QB_EXPLANATION_EFFORT=low

QB_MAX_OUTPUT_TOKENS=16000
QB_LLM_TIMEOUT_SECONDS=120
# SDK-level automatic retries for 429 / 5xx / connection errors.
# (Gemini caches the stable prompt prefix - role, rules, schema - automatically.)
QB_LLM_MAX_RETRIES=2

# --- Database ----------------------------------------------------------------
# Blank = the bundled SQLite demo database (data/querybridge_demo.db).
# Examples (PostgreSQL/MySQL are EXPERIMENTAL, see requirements-optional.txt):
#   QB_DATABASE_URL=sqlite:///absolute/path/to/your.db
#   QB_DATABASE_URL=postgresql+psycopg://readonly_user:password@localhost:5432/mydb
#   QB_DATABASE_URL=mysql+pymysql://readonly_user:password@localhost:3306/mydb
# Use a READ-ONLY database account. QueryBridge also enforces read-only access.
QB_DATABASE_URL=
QB_DATA_DIR=data

# --- Safety & execution limits ----------------------------------------------
QB_QUERY_TIMEOUT_SECONDS=10
QB_MAX_RESULT_ROWS=1000
# Regeneration attempts after a failed validation/verification/execution.
# Hard maximum is 3 – larger values are rejected at startup.
QB_MAX_CORRECTION_ATTEMPTS=2
QB_MAX_QUESTION_CHARS=1000

# --- Prompt construction ----------------------------------------------------
# Previous turns kept for follow-up questions.
QB_CONVERSATION_TURNS=5
# Few-shot examples selected per question (0 disables few-shot).
QB_FEW_SHOT_K=4
# Send the whole schema when it has at most this many tables (stable, cacheable
# prompt prefix); larger schemas switch to retrieval of the most relevant
# tables (capped at QB_SCHEMA_MAX_TABLES, plus join "bridge" tables).
QB_SCHEMA_FULL_CONTEXT_MAX_TABLES=12
QB_SCHEMA_MAX_TABLES=6
# Include a few distinct values of low-cardinality text columns (as data).
QB_INCLUDE_SAMPLE_VALUES=true
QB_SAMPLE_VALUES_PER_COLUMN=10
QB_ENABLE_SEMANTIC_VERIFICATION=true
# Show a low-confidence warning below this composite confidence (0–1).
QB_CONFIDENCE_WARNING_THRESHOLD=0.6
# "Today" as seen by the model, YYYY-MM-DD (blank = real current date).
QB_REFERENCE_DATE=

# --- Logging ------------------------------------------------------------------
QB_LOG_LEVEL=INFO
# Optional rotating log file, e.g. logs/querybridge.log (secrets are redacted).
QB_LOG_FILE=
